#!/usr/bin/env bash
set -euo pipefail

herdr_json="$HOME/.config/herdr/herdr-json"

agents=$("$herdr_json" agent list)

selected=$(
  printf '%s' "$agents" |
    jq -r '
      .result.agents[]
      | [
          .pane_id,
          (if .focused then "*" else " " end),
          .agent,
          .agent_status,
          .workspace_id,
          .tab_id,
          .pane_id,
          (.foreground_cwd // .cwd)
        ]
      | @tsv
    ' |
    fzf \
      --reverse \
      --prompt="Agent> " \
      --header="Enter: focus agent" \
      --delimiter=$'\t' \
      --with-nth=2.. \
      --nth=2..
)

if [[ -z "$selected" ]]; then
  exit 0
fi

target=${selected%%$'\t'*}
"$herdr_json" agent focus "$target" >/dev/null
"$herdr_json" pane zoom --current --off >/dev/null
