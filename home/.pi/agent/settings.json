{
  "packages": [
    "npm:pi-subagents",
    "npm:pi-web-access",
    "npm:@ff-labs/pi-fff",
    "npm:pi-stop",
    "npm:pi-antigravity",
    "npm:@juanibiapina/pi-extension-settings",
    "git:github.com/algal/pi-openai-server-compaction",
    "npm:pi-smart-compact",
    "npm:pi-meta-oauth"
  ],
  "defaultProjectTrust": "always",
  "lastChangelogVersion": "1.0.0",
  "images": {
    "blockImages": false
  },
  "terminal": {
    "showImages": false
  },
  "hideThinkingBlock": true,
  "quietStartup": true,
  "steeringMode": "all",
  "followUpMode": "all",
  "collapseChangelog": true,
  "smartCompact": {
    "mode": "balanced",
    "autoTrigger": true,
    "autoTriggerStrategy": "settled",
    "requireApproval": false,
    "minContextPercent": 95,
    "profiles": {
      "aggressive": {
        "keepRecentTokens": 20000,
        "summaryBudgetTokens": 3000
      }
    }
  },
  "compaction": {
    "keepRecentTokens": 12000
  },
  "defaultProvider": "opencode-go",
  "defaultModel": "kimi-k3",
  "defaultThinkingLevel": "max",
  "theme": "dark"
}
