# Shared by install.sh, Home Manager sessions, and the no-mistakes service.
# shellcheck disable=SC2034 # Consumers export these assignments.
DO_NOT_TRACK=1
DISABLE_TELEMETRY=1
DISABLE_ERROR_REPORTING=1
CLAUDE_CODE_ENABLE_TELEMETRY=0
NO_MISTAKES_TELEMETRY=0
LAVISH_AXI_TELEMETRY=0
PI_TELEMETRY=0
CHROME_DEVTOOLS_MCP_NO_USAGE_STATISTICS=1
DETSYS_IDS_TELEMETRY=disabled
NIX_INSTALLER_DIAGNOSTIC_ENDPOINT=
NIX_SENTRY_ENDPOINT=
